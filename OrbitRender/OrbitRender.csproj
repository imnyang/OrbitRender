<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
 <Import Project="$(MSBuildExtensionsPath)/$(MSBuildToolsVersion)/Microsoft.Common.props" />
 <PropertyGroup>
  <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
  <ProjectGuid>{6D295B50-05F2-474C-BC70-B38B0FC0A3FF}</ProjectGuid>
  <OutputType>Library</OutputType><TargetFrameworkVersion>v4.8</TargetFrameworkVersion><LangVersion>latest</LangVersion><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  <AssemblyName>OrbitRender</AssemblyName><RootNamespace>OrbitRender</RootNamespace>
  <OutputPath>bin/$(Configuration)/</OutputPath><Optimize>true</Optimize>
  <NativeProjectDirectory Condition="'$(NativeProjectDirectory)' == ''">$(MSBuildProjectDirectory)/../../OrbitRender.rs</NativeProjectDirectory>
  <TargetFrameworkRootPath Condition="Exists('../packages/net48/build/.NETFramework/v4.8')">$(MSBuildProjectDirectory)/../packages/net48/build/</TargetFrameworkRootPath>
  <GameDir Condition="'$(GameDir)' == '' and '$(OS)' == 'Windows_NT'">L:/SteamLibrary/steamapps/common/A Dance of Fire and Ice</GameDir>
  <ManagedDir>$(GameDir)/A Dance of Fire and Ice_Data/Managed</ManagedDir>
  <ModManagerDir Condition="'$(ModManagerDir)' == ''">$(ManagedDir)/UnityModManager</ModManagerDir>
  <FrameworkPathOverride Condition="Exists('../packages/net48/build/.NETFramework/v4.8')">$(MSBuildProjectDirectory)/../packages/net48/build/.NETFramework/v4.8</FrameworkPathOverride>
 </PropertyGroup>
 <ItemGroup>
  <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Data"/>
  <Reference Include="System.IO.Compression"/><Reference Include="System.IO.Compression.FileSystem"/>
  <Reference Include="$(ManagedDir)/netstandard.dll"><Private>false</Private></Reference>
  <Reference Include="$(ManagedDir)/UnityEngine*.dll"><Private>false</Private></Reference>
  <Reference Include="$(ManagedDir)/Unity.Collections.dll"><Private>false</Private></Reference>
  <Reference Include="$(ManagedDir)/Assembly-CSharp.dll"><Private>false</Private></Reference>
  <Reference Include="$(ManagedDir)/Assembly-CSharp-firstpass.dll"><Private>false</Private></Reference>
  <Reference Include="$(ManagedDir)/SkyHook.Unity.dll"><Private>false</Private></Reference>
  <Reference Include="UnityFileDialog">
   <HintPath Condition="Exists('$(ManagedDir)/UnityFileDialog.dll')">$(ManagedDir)/UnityFileDialog.dll</HintPath>
   <Private>false</Private>
  </Reference>
  <Reference Include="$(ManagedDir)/RDTools.dll"><Private>false</Private></Reference>
  <Reference Include="$(ManagedDir)/DOTween.dll"><Private>false</Private></Reference>
  <Reference Include="$(ManagedDir)/Newtonsoft.Json.dll"><Private>false</Private></Reference>
  <Reference Include="AdofaiIpc.Contracts"><HintPath>../ipc/vendor/AdofaiIpc.Contracts.dll</HintPath><Private>true</Private></Reference>
  <Reference Include="AdofaiIpc.Loader"><HintPath>../ipc/vendor/AdofaiIpc.Loader.dll</HintPath><Private>true</Private></Reference>
  <Reference Include="UnityModManager">
   <HintPath Condition="Exists('$(ModManagerDir)/UnityModManager.dll')">$(ModManagerDir)/UnityModManager.dll</HintPath>
   <HintPath Condition="!Exists('$(ModManagerDir)/UnityModManager.dll')">../packages/UnityModManager/lib/net35/UnityModManager.dll</HintPath><Private>false</Private>
  </Reference>
  <Reference Include="0Harmony">
   <HintPath Condition="Exists('$(ModManagerDir)/0Harmony.dll')">$(ModManagerDir)/0Harmony.dll</HintPath>
   <HintPath Condition="!Exists('$(ModManagerDir)/0Harmony.dll')">../packages/0Harmony.dll</HintPath><Private>false</Private>
  </Reference>
 <Compile Include="**/*.cs" Exclude="obj/**;bin/**"/>
 <Content Include="Info.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
 <Content Include="TufReplay/NOTICE.txt"><Link>NOTICE_TUFREPLAY.txt</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
 <Content Include="LICENSE.md"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
 <Content Include="Native/**/*.dll">
  <Link>%(Filename)%(Extension)</Link>
  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
 </Content>
 <EmbeddedResource Include="Localization/*.ftl" />
 <Content Include="Native/windows-x64/orbitrender_rs.dll" Condition="Exists('Native/windows-x64/orbitrender_rs.dll')"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
 <Content Include="Native/windows-x64/THIRD-PARTY-LICENSES.txt" Condition="Exists('Native/windows-x64/THIRD-PARTY-LICENSES.txt')"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
 <Content Include="Native/windows-x64/LICENSE_NATIVE" Condition="Exists('Native/windows-x64/LICENSE_NATIVE')"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
 </ItemGroup>
 <Import Project="$(MSBuildToolsPath)/Microsoft.CSharp.targets"/>
 <Target Name="BuildNativeDistribution" Condition="'$(OS)' == 'Windows_NT' and Exists('$(NativeProjectDirectory)/Cargo.toml')">
  <Exec WorkingDirectory="$(NativeProjectDirectory)" Command="cargo build --locked --release --target x86_64-pc-windows-msvc --target-dir &quot;$(NativeProjectDirectory)/target&quot;" />
  <ItemGroup>
   <NativeDistributionContent Include="$(NativeProjectDirectory)/target/x86_64-pc-windows-msvc/release/orbitrender_rs.dll" />
   <NativeDistributionContent Include="$(NativeProjectDirectory)/THIRD-PARTY-LICENSES.txt" />
   <NativeDistributionContent Include="$(NativeProjectDirectory)/LICENSE">
    <TargetName>LICENSE_NATIVE</TargetName>
   </NativeDistributionContent>
   <NativeDistributionContent>
    <TargetName Condition="'%(NativeDistributionContent.TargetName)' == ''">%(Filename)%(Extension)</TargetName>
   </NativeDistributionContent>
  </ItemGroup>
  <Copy SourceFiles="@(NativeDistributionContent)" DestinationFiles="@(NativeDistributionContent->'$(TargetDir)%(TargetName)')" />
 </Target>
 <Target Name="CreateDistributionZip" AfterTargets="Build" DependsOnTargets="BuildNativeDistribution">
  <PropertyGroup>
   <DistributionDirectory>$(MSBuildProjectDirectory)/../Build</DistributionDirectory>
   <DistributionStagingDirectory>$(MSBuildProjectDirectory)/obj/$(Configuration)/Distribution</DistributionStagingDirectory>
   <DistributionZip>$(DistributionDirectory)/OrbitRender-$([System.DateTime]::Now.ToString('yyyyMMdd-HHmmss-fff')).zip</DistributionZip>
  </PropertyGroup>
  <ItemGroup>
   <DistributionContent Include="@(Content)" />
  </ItemGroup>
  <RemoveDir Directories="$(DistributionStagingDirectory)" />
  <MakeDir Directories="$(DistributionDirectory);$(DistributionStagingDirectory)" />
  <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DistributionStagingDirectory)" />
  <MakeDir Directories="$(DistributionStagingDirectory)/ipc;$(TargetDir)/ipc" />
  <Copy SourceFiles="../ipc/vendor/AdofaiIpc.Contracts.dll;../ipc/vendor/AdofaiIpc.Loader.dll" DestinationFolder="$(DistributionStagingDirectory)" />
  <Copy SourceFiles="../ipc/vendor/ipc/AdofaiIpc.Runtime.dll;../ipc/vendor/ipc/manifest.json" DestinationFolder="$(DistributionStagingDirectory)/ipc" />
  <Copy SourceFiles="../ipc/vendor/ipc/AdofaiIpc.Runtime.dll;../ipc/vendor/ipc/manifest.json" DestinationFolder="$(TargetDir)/ipc" />
  <Copy SourceFiles="../ipc/vendor/LICENSE" DestinationFiles="$(DistributionStagingDirectory)/LICENSE_ADOFAI_IPC" />
  <Copy SourceFiles="../ipc/vendor/LICENSE" DestinationFiles="$(TargetDir)/LICENSE_ADOFAI_IPC" />
  <Copy SourceFiles="../ipc/vendor/LICENSE_MANAGED_WEBSOCKET.txt" DestinationFolder="$(DistributionStagingDirectory)" />
  <Copy SourceFiles="../ipc/vendor/LICENSE_MANAGED_WEBSOCKET.txt" DestinationFolder="$(TargetDir)" />
  <Copy SourceFiles="@(DistributionContent)" DestinationFiles="@(DistributionContent->'$(DistributionStagingDirectory)/%(Filename)%(Extension)')" />
  <Copy SourceFiles="@(NativeDistributionContent)" DestinationFiles="@(NativeDistributionContent->'$(DistributionStagingDirectory)/%(TargetName)')" />
  <ZipDirectory SourceDirectory="$(DistributionStagingDirectory)" DestinationFile="$(DistributionZip)" />
  <Message Text="Distribution ZIP: $(DistributionZip)" Importance="high" />
 </Target>
</Project>
